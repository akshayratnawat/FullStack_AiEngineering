# Supabase: Dashboard → Project Settings → API
# Only public (browser-safe) values belong here — never the service_role key or database URL.

# --- Backend API ---

VITE_API_BASE_URL=http://localhost:8000

# --- Optional ---

# Where visitors can reach you to ask for a live demo: a mailto: link or a profile URL.
# Shown as a "Contact" button in the "live questions are by invitation" notice.
VITE_CONTACT_URL=

# --- Supabase (browser auth) ---

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
