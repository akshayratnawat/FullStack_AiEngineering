# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Azure OpenAI (chat answers + embeddings) ---

# The resource key, and its URL (with or without the trailing /openai/v1).
OPENAI_API_KEY=your-azure-resource-key
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
# On Azure these are the DEPLOYMENT names you chose, not the model names.
OPENAI_CHAT_MODEL=your-chat-deployment-name
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Who may use the app. Required: comma-separated email domains (the company's own).
ALLOWED_EMAIL_DOMAINS=driftwood.com
# Optional: individual addresses outside those domains (a contractor, a developer's test account).
ALLOWED_EMAILS=
